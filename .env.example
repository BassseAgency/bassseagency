# Copia a .env.local para desarrollo. NUNCA commitear valores reales.
# Valores de ejemplo; los reales van en el gestor de secretos del proveedor.

DATABASE_URL=postgres://app:app@localhost:5432/bassseagency
# Base separada para tests de integración (se borra en cada ejecución).
TEST_DATABASE_URL=postgres://app:app@localhost:5432/bassseagency_test
APP_URL=http://localhost:3000

# Stripe (usar siempre claves de test en desarrollo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Identidad (proveedor por decidir en ADR 0002)
AUTH_SECRET=

# Observabilidad
SENTRY_DSN=
