{
  "name": "bassseagency",
  "version": "1.0.0",
  "description": "Proyecto de e-commerce construido y mantenido con agentes de IA (Claude Code y Codex).",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "dev": "tsx watch src/server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BassseAgency/bassseagency.git"
  },
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/BassseAgency/bassseagency/issues"
  },
  "homepage": "https://github.com/BassseAgency/bassseagency#readme",
  "dependencies": {
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "stripe": "^23.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
